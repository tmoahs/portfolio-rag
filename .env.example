# ---------------------------------------------------------------------------
# Modèle d'environnement de DÉVELOPPEMENT.
#   cp .env.example .env   puis renseigne les valeurs.
# En production, utiliser .env.prod (voir .env.prod.example) : ne jamais
# réutiliser les secrets de dev.
# ---------------------------------------------------------------------------

# --- Postgres ---------------------------------------------------------------
POSTGRES_USER=thomas
POSTGRES_PASSWORD=change-me-en-dev
POSTGRES_DB=portfolio_db
# Utilisé uniquement si l'API tourne hors Docker (uvicorn local).
# 127.0.0.1 plutôt que « localhost » : Windows résout d'abord ::1, où Docker
# n'écoute pas, ce qui ajoute plusieurs secondes (voire bloque) à chaque connexion.
DATABASE_URL=postgresql://thomas:change-me-en-dev@127.0.0.1:5432/portfolio_db

# --- Gemini -----------------------------------------------------------------
# Clé restreinte à l'API Generative Language (console Google Cloud).
GEMINI_API_KEY=

# --- Airflow (développement uniquement, profil "airflow") --------------------
# COMPOSE_PROFILES=airflow active Airflow avec `docker compose up -d`.
# En production, cette variable est absente : Airflow n'est ni construit ni lancé.
COMPOSE_PROFILES=airflow
AIRFLOW_UID=50000
# Génère ces valeurs avec : python scripts/gen_secrets.py
FERNET_KEY=
AIRFLOW__API_AUTH__JWT_SECRET=
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_EMAIL=admin@example.com
_AIRFLOW_WWW_USER_PASSWORD=airflow

# --- API --------------------------------------------------------------------
ENVIRONMENT=development
ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
RATE_LIMIT_ASK=10/minute
RATE_LIMIT_FEEDBACK=20/minute
# 0 = pas de plafond quotidien (pratique en dev).
DAILY_QUESTION_LIMIT=0
RETENTION_DAYS=365
# 1 uniquement derrière un reverse proxy de confiance.
TRUST_PROXY=0

# --- RAG (valeurs par défaut hors Docker) -----------------------------------
CHROMA_HOST=127.0.0.1
CHROMA_PORT=8001

# --- Cache de réponses ------------------------------------------------------
CACHE_ENABLED=1
# 1 = similarité sémantique en plus de la correspondance exacte (1 embedding/appel)
CACHE_SEMANTIC=1
CACHE_SIMILARITY_THRESHOLD=0.97
CACHE_TTL_DAYS=7
# Nombre maximum d'entrées comparées lors d'une recherche sémantique.
CACHE_MAX_ENTRIES=500
