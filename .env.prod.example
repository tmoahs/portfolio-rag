# ---------------------------------------------------------------------------
# Modèle d'environnement de PRODUCTION.
#   Sur le serveur :  cp .env.prod.example .env.prod
#   Renseigner les valeurs, puis : chmod 600 .env.prod
#
# Ce fichier ne doit JAMAIS être commité (voir .gitignore).
# Génère les secrets avec : python scripts/gen_secrets.py
# Garde une copie dans un gestionnaire de mots de passe.
# ---------------------------------------------------------------------------

# --- Domaine & TLS ----------------------------------------------------------
DOMAIN=portfolio.example.com
ACME_EMAIL=contact@example.com

# --- Postgres ---------------------------------------------------------------
POSTGRES_USER=portfolio
# Secret fort, différent de celui de dev (32+ caractères) :
POSTGRES_PASSWORD=
POSTGRES_DB=portfolio_db

# --- Gemini -----------------------------------------------------------------
# Clé restreinte à l'API Generative Language, facturation + alertes de budget.
GEMINI_API_KEY=

# --- Airflow ----------------------------------------------------------------
# NE PAS définir COMPOSE_PROFILES : Airflow n'est pas déployé en production.
AIRFLOW_UID=50000
FERNET_KEY=
AIRFLOW__API_AUTH__JWT_SECRET=
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_EMAIL=contact@example.com
_AIRFLOW_WWW_USER_PASSWORD=

# --- API --------------------------------------------------------------------
ALLOWED_ORIGINS=https://portfolio.example.com
RATE_LIMIT_ASK=8/minute
RATE_LIMIT_FEEDBACK=20/minute
# Plafond global quotidien : protège la facture Gemini.
DAILY_QUESTION_LIMIT=150
RETENTION_DAYS=365
TRUST_PROXY=1

# --- Image ------------------------------------------------------------------
IMAGE_TAG=1.0.0

# --- Cache de réponses ------------------------------------------------------
CACHE_ENABLED=1
CACHE_SEMANTIC=1
CACHE_SIMILARITY_THRESHOLD=0.97
CACHE_TTL_DAYS=7
CACHE_MAX_ENTRIES=500
